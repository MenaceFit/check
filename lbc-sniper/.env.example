# ============================================================
#  LBC Sniper — configuration
#  Copiez ce fichier en « .env » puis remplissez-le.
# ============================================================

# --- Discord ---------------------------------------------------
# Token du bot (Discord Developer Portal > votre application > Bot > Reset Token)
DISCORD_TOKEN=
# (Optionnel mais conseillé) ID de votre serveur Discord :
# les commandes /lbc apparaissent instantanément au lieu de jusqu'à 1 h.
DISCORD_GUILD_ID=

# --- Dashboard -------------------------------------------------
# 127.0.0.1 = accessible uniquement depuis ce PC (recommandé).
# 0.0.0.0   = accessible depuis le réseau (mettez alors un mot de passe !)
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8080
DASHBOARD_PASSWORD=

# --- Vitesse / sécurité anti-blocage ----------------------------
# Intervalle minimum (secondes) entre deux vérifications d'une même recherche.
LBC_MIN_INTERVAL=10
# Plafond global de requêtes vers Leboncoin par minute (toutes recherches confondues).
LBC_MAX_REQUESTS_PER_MINUTE=30

# --- Divers -----------------------------------------------------
# DATABASE_PATH=data/lbcsniper.db
# LOG_LEVEL=INFO
