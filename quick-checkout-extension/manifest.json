{
  "manifest_version": 3,
  "name": "Quick Checkout — Autocop Vinted",
  "version": "1.0.0",
  "description": "Accélère le checkout Vinted depuis le feed Autocop",

  "permissions": [
    "storage",
    "tabs",
    "cookies",
    "scripting",
    "alarms",
    "notifications"
  ],

  "host_permissions": [
    "https://www.autocop.app/*",
    "https://autocop.app/*",
    "https://www.vinted.fr/*",
    "https://www.vinted.be/*",
    "https://www.vinted.es/*",
    "https://www.vinted.de/*",
    "https://www.vinted.it/*",
    "https://www.vinted.co.uk/*",
    "https://www.vinted.nl/*",
    "https://www.vinted.pl/*",
    "https://www.vinted.pt/*",
    "https://www.vinted.com/*"
  ],

  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "https://www.autocop.app/*",
        "https://autocop.app/*"
      ],
      "js": ["content-scripts/autocop-detector.js"],
      "css": ["styles/autocop-injected.css"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.vinted.fr/*",
        "https://www.vinted.be/*",
        "https://www.vinted.es/*",
        "https://www.vinted.de/*",
        "https://www.vinted.it/*",
        "https://www.vinted.co.uk/*",
        "https://www.vinted.nl/*",
        "https://www.vinted.pl/*",
        "https://www.vinted.pt/*",
        "https://www.vinted.com/*"
      ],
      "js": ["content-scripts/vinted-checkout.js"],
      "css": ["styles/vinted-overlay.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Quick Checkout"
  },

  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://www.vinted.fr https://www.vinted.be https://www.vinted.es https://www.vinted.de https://www.vinted.it https://www.vinted.co.uk https://www.vinted.nl https://www.vinted.pl https://www.vinted.pt https://www.vinted.com https://login.v-tools.com"
  },

  "web_accessible_resources": [
    {
      "resources": ["icons/*", "styles/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
